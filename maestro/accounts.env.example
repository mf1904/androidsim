# Salin menjadi maestro/accounts.env (file itu diabaikan git) lalu isi akun uji asli.
#   cp maestro/accounts.env.example maestro/accounts.env
#
# Satu akun per device: ACC_<nn> cocok dengan AVD erp-<nn>.
# File ini di-source oleh bash, jadi beri tanda kutip bila password berisi karakter khusus.
# JANGAN commit accounts.env setelah diisi akun asli.

# Package name aplikasi yang diuji (juga bisa lewat env: APP_ID=... ./maestro/run-all.sh)
APP_ID="${APP_ID:-id.megasys.mobile}"

# Role yang menjalankan alur input produksi (dipisah spasi). Role lain hanya login.
# Role di bawah adalah contoh; ganti dengan nama role yang dipakai aplikasi Anda.
INPUT_ROLES="operator"

ACC_01_ROLE=operator; ACC_01_USER=operator01; ACC_01_PASS='GANTI_ME'
ACC_02_ROLE=qc;       ACC_02_USER=qc01;       ACC_02_PASS='GANTI_ME'
ACC_03_ROLE=manajer;  ACC_03_USER=manajer01;  ACC_03_PASS='GANTI_ME'
ACC_04_ROLE=operator; ACC_04_USER=operator02; ACC_04_PASS='GANTI_ME'
ACC_05_ROLE=qc;       ACC_05_USER=qc02;       ACC_05_PASS='GANTI_ME'
ACC_06_ROLE=manajer;  ACC_06_USER=manajer02;  ACC_06_PASS='GANTI_ME'
ACC_07_ROLE=operator; ACC_07_USER=operator03; ACC_07_PASS='GANTI_ME'
ACC_08_ROLE=qc;       ACC_08_USER=qc03;       ACC_08_PASS='GANTI_ME'
ACC_09_ROLE=manajer;  ACC_09_USER=manajer03;  ACC_09_PASS='GANTI_ME'
ACC_10_ROLE=operator; ACC_10_USER=operator04; ACC_10_PASS='GANTI_ME'
